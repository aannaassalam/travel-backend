# =============================================================================
# travel-backend environment
#
# Copy to `.env` and fill in. Every variable the code actually reads is listed
# here; anything marked REQUIRED must be set or the server will not boot.
#
# Vars under "Inherited" are read by leftover health-consultant scaffolding and
# can stay empty until the feature they belong to is actually built.
# =============================================================================

# --- REQUIRED: core ----------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/travel
# Atlas:  mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/<DB>?retryWrites=true&w=majority
MONGODB_URI=
NODE_ENV=development
PORT=3001

# --- REQUIRED: customer realm auth ------------------------------------------
# Used by /api/v1. Must be a long random string (32+ chars).
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# --- REQUIRED: admin realm auth (guide §1.3) --------------------------------
# Signs /admin/v1 tokens. MUST be different from JWT_SECRET — the guard throws
# at startup if they match. A customer token must be structurally incapable of
# being verified against the admin surface, not merely rejected by a role check.
ADMIN_JWT_SECRET=

# --- Session lifetimes (admin) ----------------------------------------------
# Defaults: 168 hours (7 days) for both. The guide recommends 8h / 0.5h; 7 days
# was chosen to stop the administrator being logged out during normal work.
# Lower these to tighten the window a stolen token stays usable.
ADMIN_SESSION_HOURS=168
ADMIN_IDLE_TIMEOUT_HOURS=168

# --- REQUIRED: CORS ----------------------------------------------------------
# Comma-separated allow-list. `*` is not accepted. Include the public site and
# the admin subdomain.
ORIGIN=http://localhost:3000,http://localhost:3001

# --- Out-of-band security alerts (§14.2) ------------------------------------
# Where login-from-new-device, recovery-code-use, export and break-glass alerts
# go. MUST NOT be an inbox reachable from inside the admin panel, or an attacker
# in the panel can suppress the alerts about his own activity.
# Currently logs to stderr when unset — see auditLog.service.ts.
ADMIN_ALERT_EMAIL=

# --- Admin provisioning (used only by `npm run seed:admin`) ------------------
# Remove these once the account exists. Password: 14+ chars, breach-checked.
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=
ADMIN_SEED_PASSWORD=
# Sealed emergency account (§1.2). Created disabled by `--break-glass`.
BREAK_GLASS_SEED_EMAIL=
BREAK_GLASS_SEED_PASSWORD=

# --- Frontend ----------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
URL=http://localhost:3001

# =============================================================================
# Inherited from the health-consultant template. Not required to boot; fill in
# only when the corresponding feature is actually built.
# =============================================================================

# Email — Azure Communication Services (primary)
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=
AZURE_SENDER_EMAIL=
ADMIN_EMAIL=

# Email — SMTP fallback
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# SMS
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# File storage — Azure Blob
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_CONTAINER_NAME=

# File storage — AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_ACCESS_KEY_SECRET=
AWS_PUBLIC_BUCKET_NAME=

# Payments — none of these are wired for the DRC market yet. The guide's money
# model (USD base, CDF/EUR display) will likely need a different provider set.
STRIPE_SECTET_KEY=
RAZOREPAY_KEY_ID=
RAZOREPAY_SECTET_KEY=
RAZORPAYX_ACCOUNT_NUMBER=
PAYU_ENV=
PAYU_BASE_URL=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PHONEPE_HOST_URL=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=

# --- REQUIRED in production: PII encryption (§14.5) --------------------------
# 32 bytes hex (64 chars). MUST be distinct from JWT_SECRET and ADMIN_JWT_SECRET
# — "encrypted at rest with a separate key" is the point. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=

# Set true to disable background jobs (cash release, passport purge, publishing)
DISABLE_CRON=

# --- File storage ------------------------------------------------------------
# local = filesystem under STORAGE_ROOT. s3 = AWS bucket (see s3.storage.ts).
# Switching drivers changes nothing else: every caller goes through the
# StorageAdapter interface.
STORAGE_DRIVER=local
STORAGE_ROOT=storage
# Where public files are served from. Local default is the /uploads route;
# for S3 set this to your CloudFront or bucket URL.
STORAGE_PUBLIC_URL=/uploads
# Signs short-lived links for PRIVATE files (travel documents). Falls back to
# ADMIN_JWT_SECRET, but a dedicated secret is better — it can be rotated without
# logging every admin out.
STORAGE_SIGNING_SECRET=
