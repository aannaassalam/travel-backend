# Essential Database Configuration
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@cluster1.dvfjtgc.mongodb.net/<DB_NAME>?retryWrites=true&w=majority&appName=Cluster1
DATABASE_PASSWORD=PASSWORD

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-should-be-at-least-32-characters-long
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Server Configuration
NODE_ENV=development
PORT=3001

# Azure Communication Services Email Configuration (Primary)
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=
AZURE_SENDER_EMAIL=DoNotReply@your-verified-domain.azurecomm.net
ADMIN_EMAIL=admin@yourdomain.com

# NodeMailer Fallback Configuration (Backup)
EMAIL_HOST=smtp.gmail.com
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_PORT=587

# SMS Configuration (MSG91)
MSG91_AUTH_KEY=your-msg91-auth-key

# --- Admin realm (guide §1.3) ---------------------------------------------
# MUST differ from JWT_SECRET. A customer token must be structurally incapable
# of reaching /admin/v1; the guard refuses to start if these two match.
ADMIN_JWT_SECRET=generate-a-second-independent-secret-at-least-32-chars

# Comma-separated CORS allow-list: public site, admin subdomain.
ORIGIN=http://localhost:3000,http://localhost:3001

# Out-of-band security alerts (§14.2). Must NOT be an inbox reachable from the
# admin panel, or an attacker inside the panel can suppress its own alerts.
ADMIN_ALERT_EMAIL=

# Used only by `npm run seed:admin`. Remove after provisioning.
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=
ADMIN_SEED_PASSWORD=
BREAK_GLASS_SEED_EMAIL=
BREAK_GLASS_SEED_PASSWORD=
