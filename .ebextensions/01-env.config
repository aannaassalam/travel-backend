# Default environment properties for every Elastic Beanstalk deploy.
#
# NODE_ENV MUST be 'production' on a deployed box: errorController only
# returns stack traces / error details when NODE_ENV === 'development', and
# .env.example ships NODE_ENV=development, so a copy-paste deploy would leak
# them. A value set in the EB console (Configuration > Updates, monitoring,
# and logging > Environment properties) overrides this file — check there if
# this appears not to take effect.
option_settings:
   aws:elasticbeanstalk:application:environment:
      NODE_ENV: production
